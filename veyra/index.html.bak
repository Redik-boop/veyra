<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Veyra | Offline Social Network</title>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        veyra: {
                            black: '#000000',
                            charcoal: '#121212',
                            darkgray: '#1E1E1E',
                            accentBlue: '#3B82F6',
                            accentGreen: '#10B981',
                            textMain: '#FFFFFF',
                            textMuted: '#A0A0A0',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #000; color: #fff; margin: 0; font-family: system-ui, sans-serif; }
        .glass-panel { background: rgba(30, 30, 30, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
        @keyframes draw { 0% { stroke-dasharray: 0 100; opacity: 0; } 50% { opacity: 1; } 100% { stroke-dasharray: 100 0; opacity: 1; } }
        .animate-draw { stroke-dasharray: 100; stroke-dashoffset: 100; animation: draw 1.2s ease-out forwards; }
        @keyframes star-journey {
            0% { transform: translate(100px, -100vh) rotate(0deg); opacity: 0; }
            20% { transform: translate(80px, 0) rotate(180deg); opacity: 1; }
            50% { transform: translate(-100px, 0) rotate(360deg); }
            80% { transform: translate(-100px, -100px) rotate(720deg); }
            100% { transform: translate(0, -200px) rotate(1080deg) scale(0); opacity: 0; }
        }
        .animate-star-journey { animation: star-journey 2.5s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, createContext, useContext, useRef } = React;

        // --- UTILS ---
        const cn = (...inputs) => inputs.filter(Boolean).join(' ');

        // --- STORAGE (Simplified for Single File) ---
        const initDB = async () => {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open('veyra_db', 1);
                request.onupgradeneeded = (e) => {
                    const db = request.result;
                    const stores = ['users', 'posts', 'comments', 'messages', 'follows', 'groups', 'groupMembers', 'videos', 'music', 'notifications'];
                    stores.forEach(s => { if (!db.objectStoreNames.contains(s)) db.createObjectStore(s, { keyPath: 'id' }); });
                };
                request.onsuccess = () => resolve(request.result);
                request.onerror = () => reject(request.error);
            });
        };

        const getItems = async (db, storeName) => {
            return new Promise((resolve) => {
                const tx = db.transaction(storeName, 'readonly');
                const store = tx.objectStore(storeName);
                const request = store.getAll();
                request.onsuccess = () => resolve(request.result);
            });
        };

        const putItem = async (db, storeName, item) => {
            return new Promise((resolve) => {
                const tx = db.transaction(storeName, 'readwrite');
                const store = tx.objectStore(storeName);
                store.put(item);
                tx.oncomplete = () => resolve();
            });
        };

        // --- AUTH CONTEXT ---
        const AuthContext = createContext(null);
        const AuthProvider = ({ children }) => {
            const [currentUser, setCurrentUser] = useState(null);
            useEffect(() => {
                const saved = localStorage.getItem('veyra_session');
                if (saved) setCurrentUser(JSON.parse(saved));
            }, []);
            const logout = () => { localStorage.removeItem('veyra_//session'); setCurrentUser(null); };
            return <AuthContext.Provider value={{ currentUser, setCurrentUser, isAuthenticated: !!currentUser, logout }}>{children}</AuthContext.Provider>;
        };
        const useAuth = () => useContext(AuthContext);

        // --- COMPONENTS ---
        const StartupAnimation = () => (
            <div className="fixed inset-0 z-[100] bg-black flex items-center justify-center overflow-hidden">
                <div className="relative w-full h-full flex items-center justify-center">
                    <svg viewBox="0 0 100 100" className="w-32 h-32 text-veyra-accentBlue" style={{filter: 'drop-shadow(0 0 15px rgba(59, 130, 246, 0.5))'}}>
                        <path fill="none" stroke="currentColor" strokeWidth="8" strokeLinecap="round" strokeLinejoin="round" d="M30 50 L45 65 L70 35" className="animate-draw" />
                    </svg>
                    <div className="absolute text-yellow-400 animate-star-journey">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.787 1.4 8.168L12 18.896l-7.334 3.86 1.4-8.168-5.934-5.787 8.2-1.192z" /></svg>
                    </div>
                </div>
            </div>
        );

        const LandingPage = ({ onEnter }) => (
            <div className="min-h-screen bg-black text-white flex flex-col items-center justify-center text-center p-4">
                <div className="relative w-20 h-20 bg-veyra-accentBlue rounded-3xl flex items-center justify-center mb-6 rotate-3">
                    <span className="text-white font-bold text-5xl -rotate-3">V</span>
                    <div className="absolute -right-1 -bottom-1 w-4 h-4 bg-yellow-400 rounded-full" />
                </div>
                <h1 className="text-6xl font-extrabold mb-4">Veyra<span className="text-veyra-accentBlue">.</span></h1>
                <p className="text-xl text-veyra-textMuted mb-10 max-w-lg">The world's first high-fidelity offline social network.</p>
                <button onClick={onEnter} className="bg-white text-black px-8 py-4 rounded-full font-bold text-lg hover:bg-veyra-accentBlue hover:text-white transition-all">Launch Veyra</button>
            </div>
        );

        const HomeFeed = () => {
            const [posts, setPosts] = useState([]);
            const [db, setDb] = useState(null);
            useEffect(() => { initDB().then(setDb); }, []);
            useEffect(() => { if (db) getItems(db, 'posts').then(setPosts); }, [db]);
            return (
                <div className="max-w-2xl mx-auto py-8">
                    <h1 className="text-2xl font-bold mb-6">Home Feed</h1>
                    <div className="space-y-4">
                        {posts.map(p => (
                            <div key={p.id} className="glass-panel p-4 rounded-2xl">
                                <p className="text-white">{p.content}</p>
                            </div>
                        ))}
                    </div>
                </div>
            );
        };

        const AppContent = () => {
            const { isAuthenticated, setCurrentUser } = useAuth();
            const [stage, setStage] = useState('animation');
            useEffect(() => { setTimeout(() => setStage('landing'), 3000); }, []);

            if (stage === 'animation') return <StartupAnimation />;
            if (stage === 'landing') return <LandingPage onEnter={() => setStage('app')} />;

            if (!isAuthenticated) {
                return <div className="h-screen flex items-center justify-center bg-black text-white">
                    <button onClick={() => setCurrentUser({id:'u1', username:'user', displayName:'Demo User'})} className="bg-veyra-accentBlue px-6 py-2 rounded-full font-bold">Login as Demo</button>
                </div>;
            }

            return (
                <div className="flex h-screen bg-black text-white">
                    <aside className="w-64 bg-veyra-charcoal p-4 hidden md:block border-r border-white/10">
                        <div className="font-bold text-xl mb-8">Veyra</div>
                        <nav className="space-y-2">
                            <div className="p-2 bg-veyra-accentBlue rounded-lg">Home</div>
                            <div className="p-2 hover:bg-white/5 rounded-lg cursor-pointer">Explore</div>
                            <div className="p-2 hover:bg-white/5 rounded-lg cursor-pointer">Profile</div>
                        </nav>
                    </aside>
                    <main className="flex-1 overflow-y-auto custom-scrollbar">
                        <HomeFeed />
                    </main>
                </div>
            );
        };

        const App = () => (
            <AuthProvider>
                <AppContent />
            </AuthProvider>
        );

        ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>
</html>
